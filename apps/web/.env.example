# =========================================================================
# SkillPilot Environment Configuration Template
# NOTE: All secret keys below are server-side only. Never expose to client!
# =========================================================================

# -------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon Serverless)
# -------------------------------------------------------------------------
# Local dev: postgresql://skillpilot:password@localhost:5432/skillpilot
# Production: postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/skillpilot?sslmode=require
DATABASE_URL=
# Set to 'true' for cloud providers like Neon Serverless; 'false' for local unencrypted dev
DATABASE_SSL=true
# Connection pool size (default: 10)
DB_POOL_MAX=10

# -------------------------------------------------------------------------
# 2. WEB APPLICATION & SECURITY HEADERS
# -------------------------------------------------------------------------
# Origin permitted for CORS & CSRF protection (NEVER use localhost in production!)
# Local dev: http://localhost:3000
# Production: https://skillpilot.your-domain.com or https://skillpilot.vercel.app
SKILLPILOT_ALLOWED_ORIGIN=http://localhost:3000
# Trust reverse-proxy X-Forwarded-For headers (set to 'true' on Vercel/Render/Railway)
SKILLPILOT_TRUST_PROXY=false
# Secure HTTP-only cookies (set to 'true' in production with HTTPS)
SKILLPILOT_SECURE_COOKIES=true
# Secret key for hashing IPs and user-agents in security_events audit table (generate: openssl rand -hex 32)
SKILLPILOT_HASH_SECRET=

# -------------------------------------------------------------------------
# 3. AI COMPANION & AGENT PROVIDER (Google Gemini Primary)
# -------------------------------------------------------------------------
# Google Gemini API Key (free tier available at https://aistudio.google.com)
GEMINI_API_KEY=
# Fast and strong model tiers
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash

# Optional secondary fallback LLM: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-20241022

# Agent rate limits and safeguards
SKILLPILOT_AGENT_HOURLY_CAP=200
# SKILLPILOT_AGENT_GLOBAL_CAP=
# Kill switch: set to 'false' to disable AI companion globally
SKILLPILOT_AGENT_ENABLED=true
# Comma-separated list of disabled tool names (e.g. "update_roadmap,propose_schedule")
# SKILLPILOT_DISABLED_TOOLS=

# -------------------------------------------------------------------------
# 4. EMAIL SERVICE (Verification & Password Resets via Resend)
# -------------------------------------------------------------------------
# Resend API key (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=SkillPilot <no-reply@your-domain.com>
# Force require email verification on signup (defaults to true when RESEND_API_KEY is configured)
# SKILLPILOT_REQUIRE_EMAIL_VERIFICATION=false

# Audit retention in days
SKILLPILOT_RETENTION_AGENT_DAYS=90
SKILLPILOT_RETENTION_EVENTS_DAYS=90

# -------------------------------------------------------------------------
# 5. REAL-TIME VIDEO CALLING (LiveKit Cloud Mentor-Student Calling)
# -------------------------------------------------------------------------
# LiveKit Cloud WebSocket URL (free tier at https://livekit.io - wss://<project>.livekit.cloud)
LIVEKIT_URL=
# LiveKit API Key (server-side only)
LIVEKIT_API_KEY=
# LiveKit API Secret (server-side only; NEVER EXPOSE TO BROWSER)
LIVEKIT_API_SECRET=

# -------------------------------------------------------------------------
# 6. CODE EXECUTION RUNNERS (Multi-Provider: OnlineCompiler.io, Judge0, Piston, SQLite)
# -------------------------------------------------------------------------
# Option A: OnlineCompiler.io API (Recommended Free Hosted Runner - 10,000 runs/month free tier)
# Register free at https://api.onlinecompiler.io
# Endpoint: https://api.onlinecompiler.io/api/v2/piston/execute
# Server-side only: never prefix with NEXT_PUBLIC_ or expose to client!
ONLINECOMPILER_API_KEY=

# Option B: Judge0 CE (RapidAPI Basic Free Tier - 50 runs/day, or Self-Hosted Instance)
# RapidAPI URL: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Required if using RapidAPI: judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=

# Option C: Piston API (Self-Hosted Private Runner or Authenticated Endpoint)
# Note: Public emkc.org/api/v2/piston requires IP whitelisting as of 2/15/2026
PISTON_API_URL=
PISTON_API_KEY=

# Option D: Isolated SQL Practice Database Sandbox
# Zero configuration required! SQL practice problems automatically execute in-process
# inside an isolated in-memory SQLite sandbox (:memory:) with 100% isolation from production.
