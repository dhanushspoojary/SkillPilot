DOMAIN=skillpilot.example.com
# Production values: use a secrets manager where available.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SKILLPILOT_DB_APP_PASSWORD=replace-with-a-different-long-random-password
SKILLPILOT_ALLOWED_ORIGIN=https://your-domain.example
SKILLPILOT_TRUST_PROXY=true
SKILLPILOT_SECURE_COOKIES=true
DB_POOL_MAX=10

# Optional. Leave empty to use the deterministic agent fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SKILLPILOT_AGENT_HOURLY_CAP=200

# Bootstrap the first admin once the database is running:
# SKILLPILOT_ADMIN_EMAIL=admin@example.com
# SKILLPILOT_ADMIN_PASSWORD=use-a-unique-16+-character-password
# SKILLPILOT_ADMIN_NAME=SkillPilot Admin

# Secret key for hashing IPs/user-agents in security_events (generate: openssl rand -hex 32)
SKILLPILOT_HASH_SECRET=
# Optional global agent ceiling per hour (default: hourly cap x 50)
# SKILLPILOT_AGENT_GLOBAL_CAP=

# Email (verification and password reset) via Resend's HTTP API. With both set in production,
# email verification turns on automatically and signup/reset stop revealing which emails exist.
RESEND_API_KEY=
MAIL_FROM=SkillPilot <no-reply@your-domain.example>
# Force on/off regardless of mail configuration: true | false
# SKILLPILOT_REQUIRE_EMAIL_VERIFICATION=
# Data retention (days)
SKILLPILOT_RETENTION_AGENT_DAYS=90
SKILLPILOT_RETENTION_EVENTS_DAYS=90
